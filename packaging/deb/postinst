#!/bin/sh
set -e

# Restart (upgrade) or start (first install) the user service of every logged-in user,
# so installing a deb needs no manual systemctl call. Users without a running user
# manager are skipped: the --global enable picks them up at their next login.
user_units() {
    action=$1
    command -v systemctl >/dev/null 2>&1 || return 0
    command -v loginctl >/dev/null 2>&1 || return 0
    [ -d /run/systemd/system ] || return 0
    loginctl list-users --no-legend 2>/dev/null | awk '{print $2}' | while read -r user; do
        [ -n "$user" ] || continue
        systemctl --user -M "${user}@" daemon-reload >/dev/null 2>&1 || continue
        if [ "$action" = restart ]; then
            systemctl --user -M "${user}@" try-restart uuremote-server.service >/dev/null 2>&1 || true
        else
            systemctl --user -M "${user}@" start uuremote-server.service >/dev/null 2>&1 || true
        fi
        echo "uuremote-server: user service ${action}ed for ${user}"
    done
}

case "$1" in
    configure)
        # udev is absent in chroots/containers; never fail there.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
            udevadm trigger --name-match=uinput || true
        fi
        # debhelper does not handle user units; --global auto-starts the
        # service at every user's graphical login.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --global enable uuremote-server.service || true
        fi
        if [ -n "$2" ]; then
            user_units restart
        else
            user_units start
            echo "uuremote-server: run 'uuremote-server login' once inside your desktop session"
            echo "to scan the QR code; afterwards the service starts automatically at login."
            echo "首次使用：请在桌面会话中运行一次 uuremote-server login 扫码登录，之后服务随登录自动启动。"
        fi
        ;;
esac

exit 0
